{
  "name": "nodit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-build.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/gen-icons.mjs",
    "test:e2e": "playwright test",
    "check": "node scripts/check-strings.mjs && node scripts/check-colours.mjs && node scripts/check-decks.mjs && node scripts/tokens.mjs --check && node scripts/check-reference.mjs",
    "lint": "tsc --noEmit",
    "tokens": "node scripts/tokens.mjs",
    "fonts:review": "node scripts/compare-fonts.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "preact": "^10.29.8",
    "@fontsource/archivo-black": "^5.2.0"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@preact/preset-vite": "^2.10.6",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "workbox-window": "^7.4.1",
    "@playwright/test": "^1.58.0",
    "sharp": "^0.34.0",
    "culori": "^4.0.2",
    "@fontsource/bricolage-grotesque": "^5.2.0",
    "@fontsource/unbounded": "^5.2.0"
  }
}
